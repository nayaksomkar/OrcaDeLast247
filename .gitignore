# Environment
.env
.env.*
!*.env.example
!*.env.example/
.env.example
*.env
# Credential files must never be committed (read via environment only).
*.pem
.creds/

# Local databases (runtime artifacts, not source)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
db-data/

# Logs & temp/backup files
*.log
*.tmp
*.bak

# Build artifacts
dist/
build/

# OS / IDE files
.DS_Store
.idea/
.vscode/
Thumbs.db

# Built binaries
/bin/

# Test binaries
*.test

# Go workspace files (Go stack removed; keep the workspace out just in case)
go.work
go.work.sum

# Local tool directories
.codegraph
.commandcode/
.omo/
.kilo/

# Python cache & tests
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
