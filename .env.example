# === Turso / libSQL database connection ===
# Remote:   libsql://your-database-name.turso.io
# Local:    file:./news.db
TURSO_DATABASE_URL=

# Required only for remote Turso databases. Leave empty for a local file.
TURSO_AUTH_TOKEN=

# Number of days of articles to retain. The ingestion service deletes older
# rows on every run. (default: 7)
RETENTION_DAYS=7

# === News provider API keys (sequential fallback) ===
# The service tries them in this order. Only the first provider that returns
# usable articles is used per run; the rest are skipped.
#
# 1. NewsAPI  — https://newsapi.org
NEWS_API_KEY=

# 2. GNews    — https://gnews.io
GNEWS_API_KEY=

# 3. NewsData.io — https://newsdata.io
NEWS_DATA_API_KEY=

# 4. WebFetch API — a configurable fallback endpoint
WEBFETCH_API_URL=
WEBFETCH_API_KEY=

# === Ingestion options ===
# Preferred language for news articles (default: en)
NEWS_LANGUAGE=en

# Maximum articles to fetch per provider (default: 50)
MAX_ARTICLES=50

# === HTTP server options ===
# Port the service listens on (default: 8080; Render provides PORT dynamically)
PORT=8080

# How often to run background ingestion (default: 6h)
INGEST_INTERVAL=6h

# Max duration for one ingestion run (default: 120s)
INGEST_TIMEOUT=120s

# Allowed CORS origins for the Next.js frontend (comma-separated; default: *)
# Example for production: CORS_ALLOW_ORIGINS=https://app.last247.dev
CORS_ALLOW_ORIGINS=*
