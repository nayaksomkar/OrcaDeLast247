# === Turso / libSQL database connection ===
# Remote:   libsql://your-database-name.turso.io
# Local:    file:./news.db
TURSO_DATABASE_URL=

# Required only for remote Turso databases. Leave empty for a local file.
TURSO_AUTH_TOKEN=

# Number of days of articles to retain. The ingestion service deletes older
# rows on every run. (default: 7)
RETENTION_DAYS=7

# === News provider API keys (sequential fallback) ===
# The service tries them in this order. Only the first provider that returns
# usable articles is used per run; the rest are skipped.
#
# 1. NewsAPI  — https://newsapi.org
NEWS_API_KEY=

# 2. GNews    — https://gnews.io
GNEWS_API_KEY=

# 3. NewsData.io — https://newsdata.io
NEWS_DATA_API_KEY=

# 4. WebFetch API — a configurable fallback endpoint
WEBFETCH_API_URL=
WEBFETCH_API_KEY=

# === Ingestion options ===
# Preferred language for news articles (default: en)
NEWS_LANGUAGE=en

# Max articles fetched per provider per run. 3 runs/day × 7 articles = 21
# LLMPing parse calls/day (default: 7)
MAX_ARTICLES=7

# === HTTP server options ===
# Port the service listens on (default: 8080; Render provides PORT dynamically)
PORT=8080

# How often to run background ingestion (default: 8h — 3 runs/day)
INGEST_INTERVAL=8h

# Max duration for one ingestion run. Must cover the provider fetch plus up
# to MAX_ARTICLES sequential LLMPing parse calls (default: 900s)
INGEST_TIMEOUT=900s

# Allowed CORS origins for the Next.js frontend (comma-separated; default: *)
# Example for production: CORS_ALLOW_ORIGINS=https://app.last247.dev
CORS_ALLOW_ORIGINS=*

# === SAMPLE_DATA mode (testing only) ===
# SAMPLE_DATA=true  → do NOT call the real news APIs; load the bundled sample
#                     articles (data/sample_news.json) and run them through
#                     the SAME pipeline: provider normalization → article
#                     selection → LLMPing parse → Turso → API. Useful for
#                     testing without consuming news API quotas.
# SAMPLE_DATA=false → real configured providers (production default).
SAMPLE_DATA=false

# === LLMPing (LLM Brain) ===
# All inference happens in the external LLMPing service — no LLM runs here.
# After fetching, each stored article is sent to LLMPing /chat with the
# system prompt + article data, and the parsed answer is stored on the row.
# Full endpoint URL (wins over LLMPING_BASE_URL + LLMPING_CHAT_PATH):
LLMPING_API_URL=https://llmping.onrender.com/chat

# Fallback URL parts, used when LLMPING_API_URL is empty:
LLMPING_BASE_URL=https://llmping.onrender.com
LLMPING_CHAT_PATH=/chat

# Max seconds per LLMPing /chat call (default: 60s)
LLMPING_TIMEOUT=60s

# Optional Bearer token. Empty = no auth header is sent (LLMPing currently
# requires none). Never put real secrets in source files.
LLMPING_API_TOKEN=

# System instructions sent with every article. Empty = built-in placeholder
# in llmping.py (DEFAULT_SYSTEM_PROMPT). The shipped .env uses this editorial
# prompt, which makes the stored llm_answer a strict single JSON object the UI
# can parse directly (fields: title, url, source, author, category,
# published_at, summary, key_points[]):
#
# LLM_SYSTEM_PROMPT=You are the Last247 news parser. Parse the article in the
#   ARTICLE DATA section into clean structured news data. Use ONLY the supplied
#   article fields — never invent facts and never add outside knowledge. Reply
#   with a single raw JSON object and nothing else: no markdown, no code fences,
#   no commentary. Required shape: {"title": echo unchanged, "url": echo
#   unchanged, "source": echo or "", "author": echo or "", "category": echo or
#   "", "published_at": echo unchanged, "summary": 2-3 concise sentences based
#   only on the description and content, "key_points": at most 3 short factual
#   strings taken from the article}. Omitted fields become "" and missing
#   key_points become [].
LLM_SYSTEM_PROMPT=

# Max characters of article description/content included in a prompt
# (default: 4000)
LLM_MAX_CONTENT_CHARS=4000
