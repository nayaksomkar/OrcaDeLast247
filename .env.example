# ============================================================================
# Last247 backend environment configuration
#
# SENSITIVE      — credentials and keys. NEVER commit, never log, never
#                  expose to the frontend. Live only in this file (gitignored)
#                  or the platform's env-var UI.
# NON-SENSITIVE  — operational configuration. Safe to share; no credentials.
# ============================================================================

# ============================ SENSITIVE =====================================

# --- Turso / libSQL database (credentials) ---
# Remote:   libsql://your-database-name.turso.io
# Local:    file:./news.db
TURSO_DATABASE_URL=

# Required only for remote Turso databases. Leave empty for a local file.
TURSO_AUTH_TOKEN=

# --- News provider API keys (sequential fallback) ---
# 1. NewsAPI  — https://newsapi.org
NEWS_API_KEY=

# 2. GNews    — https://gnews.io
GNEWS_API_KEY=

# 3. NewsData.io — https://newsdata.io
NEWS_DATA_API_KEY=

# 4. WebFetch API — a configurable fallback endpoint (may be private)
WEBFETCH_API_URL=
WEBFETCH_API_KEY=

# --- LLMPing (LLM Brain) auth ---
# Optional Bearer token. Empty = no auth header is sent. Never commit a real
# token to any source file.
LLMPING_API_TOKEN=

# ========================== NON-SENSITIVE ===================================

# --- Ingestion options ---
# Preferred language for news articles (default: en)
NEWS_LANGUAGE=en

# Max articles collected per ingestion run (across the provider fallback,
# still one provider at a time). 12 runs/day × 10 articles = up to 120
# LLMPing parse calls/day (default: 10)
MAX_ARTICLES=10

# Number of days of articles to retain. Older rows are deleted every run.
# (default: 7)
RETENTION_DAYS=7

# --- HTTP server options ---
# Port the service listens on (default: 8080; Render provides PORT dynamically)
PORT=8080

# How often to run background ingestion (default: 2h — 12 runs/day)
INGEST_INTERVAL=2h

# How often the NULL/empty repair check runs. It scans Turso for rows with
# NULL/empty category or llm_* fields and repairs ONLY those rows; healthy
# rows are never reprocessed (default: 2h)
NULL_CHECK_INTERVAL=2h

# --- One-shot / one-time modes ---
# RUN_ONCE=true → `python main.py` runs backfill (if flagged) → ONE ingestion
#   → ONE repair pass → exits cleanly. No scheduler, no server. Great for
#   local testing. Keep FALSE (or unset) on the live deployment.
RUN_ONCE=true

# CATEGORY_BACKFILL_ONCE=true → on startup, run the ONE-TIME category backfill
#   over the EXISTING rows (only rows missing category/llm data are touched).
#   A "category_backfill_done" marker is written to the DB meta table after a
#   successful pass, so every later startup is a no-op. After the migration
#   has run once you can remove this variable entirely.
CATEGORY_BACKFILL_ONCE=true

# Max duration for one ingestion run. Must cover the provider fetch plus up
# to MAX_ARTICLES sequential LLMPing parse calls (default: 900s)
INGEST_TIMEOUT=900s

# Allowed CORS origins for the Next.js frontend (comma-separated; default: *)
# Example for production: CORS_ALLOW_ORIGINS=https://app.last247.dev
CORS_ALLOW_ORIGINS=*

# --- SAMPLE_DATA mode (testing only) ---
# true  → do NOT call the real news APIs; load the bundled sample articles
#         (data/sample_news.json) and run them through the SAME pipeline.
# false → real configured providers (production default).
SAMPLE_DATA=false

# --- LLMPing (LLM Brain) endpoint/config (public service) ---
# Full endpoint URL (wins over LLMPING_BASE_URL + LLMPING_CHAT_PATH):
LLMPING_API_URL=https://llmping.onrender.com/chat

# Fallback URL parts, used when LLMPING_API_URL is empty:
LLMPING_BASE_URL=https://llmping.onrender.com
LLMPING_CHAT_PATH=/chat

# Max seconds per LLMPing /chat call (default: 60s)
LLMPING_TIMEOUT=60s

# System instructions sent with every article. Empty = built-in placeholder
# in llmping.py (DEFAULT_SYSTEM_PROMPT).
LLM_SYSTEM_PROMPT=

# Max characters of article description/content included in a prompt
# (default: 4000)
LLM_MAX_CONTENT_CHARS=4000
